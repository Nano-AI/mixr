OPENAI_API_KEY=
LLM_MODEL=gpt-6-luna
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMS=1536
# off = no LLM in the matching/profile/event pipeline (vector-only ranking, template copy). The agent still uses the LLM.
PIPELINE_LLM=on
# 1 = offline fake LLM + embeddings (tests, credit-free dev)
MIXR_FAKE=0
DB_DIR=./data/mixr
PORT=8787
