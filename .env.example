# messaging (Wayne)
# Spectrum connection (npm start); npm run spectrum is the standalone echo demo.
PROJECT_ID=
PROJECT_SECRET=
TRANSPORT=photon             # console | photon
PHOTON_API_KEY=
PHOTON_PROJECT_ID=           # v2 ids start with pho_prj_
PHOTON_WEBHOOK_SECRET=
ADMIN_TOKEN=
JOIN_ORIGINS=https://joinmixr.club,https://www.joinmixr.club  # CORS for POST /join
EMAIL_PROVIDER=gmail        # gmail | resend
GMAIL_USER=                  # dedicated @gmail.com sender
GMAIL_APP_PASSWORD=          # Google app password, not the account password
RESEND_API_KEY=              # required only for resend
EMAIL_FROM=                  # verified Resend sender, e.g. Mixr <hello@your-domain>

# matching (John)
LLM=anthropic                # anthropic | fake
ANTHROPIC_API_KEY=

# runtime
DB_PATH=mixr.db
TZ=America/Los_Angeles
PORT=3000
HOST=127.0.0.1               # use 0.0.0.0 in containers
