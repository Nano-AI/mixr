# --- runtime ---
PORT=8787
HOST=127.0.0.1               # 0.0.0.0 in containers
DB_DIR=./data/mixr           # PGlite data directory (memory:// in tests)
TZ=America/Los_Angeles
# Public base URL of this server (used for links). Any hostname works: a johnomeara.com tunnel subdomain,
# or api.joinmixr.club once DNS for it points at Cloudflare (Cloudflare for SaaS or nameservers).
PUBLIC_URL=https://api.joinmixr.club
# Dashboard + /api/* login (Bearer token or the dashboard login form). Required in production.
ADMIN_TOKEN=

# --- Claude (conversation + matching pipeline) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_WORKSPACE_ID=      # only for keys that aren't workspace-scoped
CLAUDE_DAILY_REQUEST_LIMIT=1000   # hard cap on attempted requests per UTC day (tool follow-ups count)
# off = no LLM in matching/profiles/events (vector-only ranking, template copy). The agent still uses Claude.
PIPELINE_LLM=on

# --- embeddings (OpenAI, embeddings only) ---
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMS=1536

# --- Photon (iMessage via Spectrum, shared line) ---
TRANSPORT=photon             # photon | sim (sim = dashboard only, nothing delivered)
PROJECT_ID=
PROJECT_SECRET=
JOIN_ORIGINS=https://joinmixr.club,https://www.joinmixr.club   # CORS for POST /join (add a Vercel preview origin to test)
DEV_JOIN_NUMBER=             # TRANSPORT=sim only: the number /join hands out (default +15555550100)

# --- UW email verification ---
EMAIL_PROVIDER=gmail         # gmail | resend
GMAIL_USER=                  # dedicated @gmail.com sender
GMAIL_APP_PASSWORD=          # Google app password, not the account password
RESEND_API_KEY=              # only for resend
EMAIL_FROM=                  # verified Resend sender

# 1 = offline fake LLM + embeddings (tests, credit-free dev)
MIXR_FAKE=0
