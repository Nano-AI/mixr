{
  "name": "mixr",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "server": "tsx watch src/server.ts",
    "web": "npm --prefix web run dev",
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm run server\" \"npm run web\"",
    "seed": "tsx scripts/seed.ts",
    "import:uw-events": "tsx scripts/import-uw-events.ts",
    "eval": "tsx scripts/eval/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "node --import tsx src/server.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@electric-sql/pglite": "^0.5.10",
    "@electric-sql/pglite-pgvector": "^0.0.11",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "nodemailer": "^10.1.2",
    "openai": "^7.37.0",
    "spectrum-ts": "^12.11.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
